{
  "name": "forescene",
  "private": true,
  "version": "0.1.0",
  "description": "ForeScene — local-first previsualization, continuity, and AI-video handoff",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:fast": "tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo",
    "test": "vitest run --config vitest.fast.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:changed": "vitest run --config vitest.fast.config.ts --changed=origin/main",
    "goal:smoke": "node scripts/goal-workflow-smoke.mjs",
    "sync:agent-skills": "node scripts/sync-agent-skills.mjs",
    "verify:agent-skills": "node scripts/verify-agent-skills.mjs",
    "agent:inspect": "tsx scripts/agent/cli.ts inspect",
    "agent:help": "tsx scripts/agent/cli.ts help",
    "agent:capabilities": "tsx scripts/agent/cli.ts capabilities",
    "agent:open": "tsx scripts/agent/cli.ts open",
    "agent:save": "tsx scripts/agent/cli.ts save",
    "agent:cancel": "tsx scripts/agent/cli.ts cancel",
    "agent:operations": "tsx scripts/agent/cli.ts operations",
    "agent:analyze-character": "tsx scripts/agent/cli.ts analyze-character",
    "agent:import-character": "tsx scripts/agent/cli.ts import-character",
    "agent:import-model": "tsx scripts/agent/cli.ts import-model",
    "agent:import-panorama": "tsx scripts/agent/cli.ts import-panorama",
    "agent:replace-proxy": "tsx scripts/agent/cli.ts replace-proxy",
    "agent:render-passes": "tsx scripts/agent/cli.ts render-passes",
    "agent:plan-exports": "tsx scripts/agent/cli.ts plan-exports",
    "agent:verify-package": "tsx scripts/agent/cli.ts verify-package",
    "agent:refine": "tsx scripts/agent/cli.ts refine",
    "agent:preview": "tsx scripts/agent/cli.ts preview",
    "agent:apply": "tsx scripts/agent/cli.ts apply",
    "agent:screenshot": "tsx scripts/agent/cli.ts screenshot",
    "agent:frame": "tsx scripts/agent/cli.ts frame",
    "agent:video": "tsx scripts/agent/cli.ts video",
    "agent:verify": "tsx scripts/agent/cli.ts verify",
    "agent:visual-preflight": "tsx scripts/agent/cli.ts visual-preflight",
    "agent:asset-contract": "tsx scripts/agent/cli.ts asset-contract",
    "agent:run": "tsx scripts/agent/cli.ts run",
    "agent:package": "tsx scripts/agent/cli.ts package",
    "agent:previs": "tsx scripts/agent/cli.ts previs",
    "agent:production": "tsx scripts/agent/cli.ts production",
    "agent:render-stills": "tsx scripts/agent/cli.ts render-stills",
    "agent:contact-sheet": "tsx scripts/agent/cli.ts contact-sheet",
    "agent:soak-saved-rig": "tsx scripts/agent/savedRigSoak.ts",
    "benchmark:coverage-import": "node scripts/coverage-import-benchmark.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "test:e2e:smoke": "playwright test --project=desktop-chromium --grep \"@smoke\"",
    "test:e2e:agent-cli": "playwright test --project=desktop-chromium --grep \"@agent-cli\"",
    "test:e2e:responsive": "playwright test --grep \"@responsive\"",
    "test:e2e:webkit": "playwright test --project=desktop-webkit --grep \"@smoke\" --grep-invert \"@webkit-gpu\" --workers=1",
    "test:e2e:webkit-gpu": "playwright test --project=desktop-webkit --grep \"@webkit-gpu\" --workers=1",
    "test:e2e:visual": "playwright test --project=desktop-chromium --project=tablet-chromium --project=phone-390 --grep \"@visual\"",
    "test:e2e:heavy": "playwright test --project=desktop-chromium --grep \"@heavy\"",
    "test:e2e:previs": "playwright test --project=desktop-chromium --grep \"autonomous previs dialogue\"",
    "test:e2e:full": "playwright test",
    "sample:generate": "node scripts/generate-sample-assets.mjs && tsx scripts/generate-dialogue-sample.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mediabunny": "^1.50.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-dropzone": "^15.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
