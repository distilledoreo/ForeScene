{
  "version": 1,
  "id": "agentic-control-v3",
  "family": "import-idempotency",
  "description": "Cheap-agent import idempotency: open seed, inspect, import ordinary-cube.glb twice, confirm counts do not duplicate, save project.fsp.",
  "seedPackage": "seed/import-empty.fsp",
  "importModel": {
    "fixtureSource": "tests/fixtures/ordinary-cube.glb",
