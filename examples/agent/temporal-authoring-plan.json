{
  "version": 1,
  "planId": "temporal-authoring-example",
  "description": "Replace one shot timeline with a four-second camera move",
  "commands": [
    {
      "op": "shot.timeline.replace",
      "shot": { "id": "shot-id" },
      "durationSeconds": 4,
      "keyframes": [
        {
          "timeSeconds": 0,
          "camera": { "position": [0, 2, 6], "target": [0, 1, 0] }
        },
        {
          "timeSeconds": 4,
          "camera": { "position": [2, 2, 4], "target": [0, 1, 0] },
          "objects": [
            {
              "object": { "ref": "cast.alex" },
              "visible": true,
              "transform": {
                "position": [1, 0.9, 0],
                "rotation": [0, 0, 0],
                "scale": [1, 1, 1]
              }
            }
          ]
        }
      ]
    }
  ]
}
